@tempo 74
@swing 0.65
@fx vinyl 0.3
@fx reverb 0.35
@fx lowpass 0.7
@instrument lead pluck 0.6
@instrument bass default 0.75
@instrument chord guitar 0.8

@sample chords cmaj_74bpm_chords_1.wav
@sample melody cmaj_74bpm_melody_1.wav
//@sample vocal 120_vocal_airy_dmin.wav

@sample kick "Kick Duty Vinyl"
@sample snare "Snare Coffee"
@sample hat "HiHat Dusty"
@sample perc "Foley Subtle"

